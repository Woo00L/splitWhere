{
  "name": "imgsplit-local",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/core/*.test.ts",
    "desktop": "npm run build && install-electron && electron .",
    "icons": "node scripts/create-icons.mjs",
    "pack:mac": "npm run build && npm run icons && electron-builder --mac --publish never",
    "pack:win": "npm run build && npm run icons && electron-builder --win --x64 --publish never",
    "pack": "npm run build && npm run icons && electron-builder --mac --win --publish never"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.2.0"
  },
  "main": "desktop/main.cjs",
  "description": "完全离线的本地图片切割工具",
  "author": "Woo00L"
}
